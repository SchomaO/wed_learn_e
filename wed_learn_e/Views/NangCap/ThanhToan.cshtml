@model wed_learn_e.Models.DonHangThanhToanViewModel
@{
    ViewBag.Title = "Thanh toán đơn hàng " + Model.MaDonHang;
    Layout = "~/Views/Shared/_Layoutcauhoi.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - KityLearn</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Img/Gemini_Generated_Image_xdycdaxdycdaxdyc-removebg-preview (1).png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container py-5">
        <div class="mb-3">
            <a href="@Url.Action("Index", "NangCap")"
               class="btn btn-light border fw-semibold px-3 py-2 rounded-3 shadow-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại 
            </a>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="fa-solid fa-building-columns text-warning me-2"></i> THANH TOÁN CHUYỂN KHOẢN NGÂN HÀNG</span>
                        <span class="badge bg-warning text-dark">Mã đơn: @Model.MaDonHang</span>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4 align-items-center">
                            <!-- Cột trái: Mã QR VietQR quét thật -->
                            <div class="col-md-5 text-center border-end">
                                <p class="fw-bold text-dark mb-2">Mở App Ngân hàng để quét mã QR</p>
                                <div class="p-3 bg-white rounded-4 d-inline-block border shadow-sm mb-3">
                                    <img src="@Model.LinkQrCode" alt="VietQR Thanh Toán" class="img-fluid" style="max-width: 260px;" />
                                </div>
                                <div class="small text-muted">
                                    Mã QR đã tự động điền sẵn <strong>Số tiền</strong> và <strong>Nội dung chuyển khoản</strong>.
                                </div>
                            </div>

                            <!-- Cột phải: Thông tin chuyển khoản thủ công & Xác nhận -->
                            <div class="col-md-7 ps-md-4">
                                <h5 class="fw-bold mb-3">Thông tin chuyển khoản</h5>

                                <div class="bg-light rounded-4 p-3 mb-4">
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="text-muted">Ngân hàng:</span>
                                        <span class="fw-bold text-dark">@Model.TenNganHang</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted">Số tài khoản:</span>
                                        <div>
                                            <span class="fw-bold text-primary fs-5" id="txtStk">@Model.SoTaiKhoan</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyText('txtStk')">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="text-muted">Chủ tài khoản:</span>
                                        <span class="fw-bold">@Model.ChuTaiKhoan</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted">Số tiền:</span>
                                        <span class="fw-bold text-danger fs-5">@Model.ThanhTien.ToString("N0")đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2">
                                        <span class="text-muted">Nội dung CK:</span>
                                        <div>
                                            <span class="fw-bold text-success fs-5" id="txtNoiDung">@Model.MaDonHang</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyText('txtNoiDung')">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted">Gói dịch vụ: <strong>@Model.TenGoi</strong> (Giảm @Model.PhanTramGiamKhoaHoc% khóa học)</span>
                                    @if (Model.TrangThai == "SUCCESS")
                                    {
                                        <span class="badge bg-success">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                    }
                                </div>

                                @if (Model.TrangThai != "SUCCESS")
                                {
                                    <div class="alert alert-warning text-center rounded-3 mt-3 mb-0">
                                        <i class="fa-solid fa-clock me-1"></i>
                                        <strong>Đang chờ quản trị viên xác nhận:</strong> Sau khi bạn chuyển khoản thành công, Admin sẽ kiểm tra và kích hoạt quyền lợi VIP cho tài khoản của bạn.
                                    </div>
                                }

                                <a href="@Url.Action("Index", "NangCap")" class="btn btn-outline-secondary w-100 py-2 rounded-3">
                                    Quay lại
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        @Html.Partial("~/Views/Trang_chu/Footer.cshtml", new ViewDataDictionary())
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
                    function copyText(elementId = "") {
                        var el = document.getElementById(elementId);
                        if (el) {
                            navigator.clipboard.writeText(el.innerText);
                            alert("Đã sao chép: " + el.innerText);
                        }
                    }
    </script>
</body>
</html>