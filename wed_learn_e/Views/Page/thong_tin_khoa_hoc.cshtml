@{
    ViewBag.Title = "Thông tin khóa học";
    Layout = "~/Views/Shared/_Layoutcauhoi.cshtml";
}

<style>
    body {
        margin: 0;
        font-family: Arial;
        background: #e9f5ff;
    }

    .title {
        text-align: center;
        padding: 40px;
        font-size: 32px;
        font-weight: bold;
        color: #0d6efd;
    }

    .course-container {
        width: 90%;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 25px;
        padding-bottom: 50px;
    }

    .course-box {
        background: white;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .course-box:hover {
            transform: translateY(-6px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

    .course-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .course-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #007bff;
    }

    .course-desc {
        font-size: 14px;
        color: #555;
        margin-bottom: 20px;
        flex-grow: 1;
    }

    .btn-course {
        background: #0d6efd;
        color: white;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        align-self: center;
    }

        .btn-course:hover {
            background: #0b5ed7;
        }

    .extra-title {
        text-align: center;
        margin-top: 40px;
        margin-bottom: 20px;
        font-size: 28px;
        font-weight: bold;
        color: #0b5ed7;
        position: relative;
    }

        .extra-title:after {
            content: "";
            width: 120px;
            height: 3px;
            background: #0d6efd;
            display: block;
            margin: 10px auto;
            border-radius: 3px;
        }
</style>
@Html.Partial("_NutQuayLai", new ViewDataDictionary {
    { "LinkQuayVe", Url.Action("khoadaotao", "Page") },
    { "TieuDe", "Khóa Học: " + ViewBag.TenCapDo }
})

<div class="course-container">

    <div class="course-box" style="background:#ffffff">
        <div class="course-icon">📖</div>
        <div class="course-title">1000 Từ Vựng Thông Dụng</div>
        <div class="course-desc">Học từ vựng cấp độ @ViewBag.TenCapDo.</div>
        <a class="btn-course" href="@Url.Action("_1000TuVung", "Page", new { id_cap_do = ViewBag.IdCapDo })">Bắt đầu học</a>
    </div>

    <div class="course-box" style="background:#eef7ff">
        <div class="course-icon">📝</div>
        <div class="course-title">Bài Kiểm Tra Tiến Độ</div>
        <div class="course-desc">Tổng hợp kiến thức cấp độ @ViewBag.TenCapDo. Mở khóa khi hoàn thành tất cả kỹ năng (đạt ≥ 70%).</div>
        <a class="btn-course" href="javascript:void(0);" onclick="kiemTraMoKhoa(@ViewBag.IdCapDo)">Làm bài test</a>
    </div>

    <div class="course-box" style="background:#f5fbff">
        <div class="course-icon">🎧</div>
        <div class="course-title">Luyện Nghe</div>
        <div class="course-desc">Các bài nghe chuẩn của @ViewBag.TenCapDo.</div>
        <a class="btn-course" href="@Url.Action("list_luyen_nghe", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Bắt đầu</a>
    </div>

    <div class="course-box" style="background:#f0f8ff">
        <div class="course-icon">🗣</div>
        <div class="course-title">Luyện Nói</div>
        <div class="course-desc">Thực hành giao tiếp tiếng Anh hàng ngày.</div>
        <a class="btn-course" href="@Url.Action("LuyenNoi", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Thực hành</a>
    </div>

    <div class="course-box" style="background:#e6f4ff">
        <div class="course-icon">📚</div>
        <div class="course-title">Ngữ Pháp Cơ Bản</div>
        <div class="course-desc">Ôn tập ngữ pháp trọng tâm.</div>
        <a class="btn-course" href="@Url.Action("_NguPhap", "Page", new { id_cap_do = ViewBag.IdCapDo })">Học ngay</a>
    </div>

    <div class="course-box" style="background:#f2f9ff">
        <div class="course-icon">🏅</div>
        <div class="course-title">Mini Test Hàng Ngày</div>
        <div class="course-desc">Các bài test nhỏ giúp ôn tập.</div>
        <a class="btn-course" href="@Url.Action("MiniTestHangNgay", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Làm bài</a>
    </div>

    <div class="course-box" style="background:#f2f9ff">
        <div class="course-icon">🎮</div>
        <div class="course-title">Game Từ Vựng</div>
        <div class="course-desc">Vừa học vừa chơi với trò chơi giải đố.</div>
        <a class="btn-course" href="@Url.Action("BanDoKhoBau", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Chơi ngay</a>
    </div>

    <div class="course-box" style="background:#e6f4ff">
        <div class="course-icon">🎬</div>
        <div class="course-title">Học Qua Video</div>
        <div class="course-desc">Học tiếng Anh qua phim ảnh và tình huống.</div>
        <a class="btn-course" href="@Url.Action("list_hoc_video", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Xem bài học</a>
    </div>

    <div class="course-box" style="background:#f0f8ff">
        <div class="course-icon">✍</div>
        <div class="course-title">Luyện Viết</div>
        <div class="course-desc">Luyện viết câu và đoạn văn.</div>
        <a class="btn-course" href="@Url.Action("list_luyen_viet", "tinh_nang", new { id_cap_do = ViewBag.IdCapDo })">Thực hành</a>
    </div>

    <div class="course-box" style="background:#f5fbff">
        <div class="course-icon">💡</div>
        <div class="course-title">Thành Ngữ Tiếng Anh</div>
        <div class="course-desc">Học các idioms thông dụng.</div>
        <a class="btn-course" href="@Url.Action("_ThanhNgu", "Page", new { id_cap_do = ViewBag.IdCapDo })">Xem ngay</a>
    </div>
    @if (ViewBag.DanhSachKhoaHocMoi != null)
    {
        foreach (var kh in ViewBag.DanhSachKhoaHocMoi)
        {
            <div class="course-box" style="background:#fff7e6; border: 1px solid #ffe8cc;">
                <div class="course-icon">🌟</div>
                <div class="course-title">@kh.ten_khoa_hoc</div>
                <div class="course-desc">@kh.mo_ta</div>
                <a class="btn-course" style="background: #ff8c00;" href="@Url.Action("NoiDungKhoaHoc", "Page", new { id_khoa_hoc = kh.id_khoa_hoc })">Bắt đầu học</a>
            </div>
        }
    }
</div>
<!-- CSS & HTML CHO POPUP THÔNG BÁO -->
<style>
    .lock-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(5px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

    .lock-modal {
        background: #ffffff;
        width: 92%;
        max-width: 440px;
        border-radius: 20px;
        padding: 32px 28px;
        text-align: center;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.2);
        animation: modalPop 0.25s ease-out;
        font-family: Arial, sans-serif;
    }

    @@keyframes modalPop {
        from {
            transform: scale(0.88);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .lock-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        background: #fff3cd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        box-shadow: 0 6px 16px rgba(255, 193, 7, 0.25);
    }

    .lock-title {
        font-size: 20px;
        font-weight: bold;
        color: #1e293b;
        margin-bottom: 12px;
    }

    .lock-msg-vi {
        font-size: 15px;
        color: #334155;
        line-height: 1.5;
        margin-bottom: 8px;
    }

    .lock-msg-en {
        font-size: 14px;
        color: #64748b;
        font-style: italic;
        line-height: 1.5;
        margin-bottom: 24px;
        padding-top: 8px;
        border-top: 1px dashed #e2e8f0;
    }

    .lock-btn {
        background: linear-gradient(135deg, #0d6efd, #3b82f6);
        color: #fff;
        border: none;
        padding: 12px 28px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
        width: 100%;
    }

        .lock-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(13, 110, 253, 0.35);
        }
</style>

<div class="lock-overlay" id="lockModal" onclick="if(event.target === this) dongPopupKhoa()">
    <div class="lock-modal">
        <div class="lock-icon-wrap" id="lockIcon">🔒</div>
        <div class="lock-title" id="lockTitle">Chưa mở khóa / Test Locked</div>
        <div class="lock-msg-vi" id="lockMsgVi"></div>
        <div class="lock-msg-en" id="lockMsgEn"></div>
        <div style="display:flex; gap:12px;">
            <button type="button" id="lockBtnCancel" onclick="dongPopupKhoa()"
                    style="display:none; flex:1; background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:12px; border-radius:10px; font-size:15px; font-weight:bold; cursor:pointer;">
                Đóng / Cancel
            </button>
            <button type="button" class="lock-btn" id="lockBtn" onclick="xacNhanPopup()" style="flex:1;">
                Đã hiểu / Got it
            </button>
        </div>
    </div>
</div>

<script>
        var pendingRedirect = null;

        function moPopupKhoa(title, msgVi, msgEn, redirectUrl, isConfirmRetake, daDat) {
            document.getElementById("lockTitle").innerText = title;
            document.getElementById("lockMsgVi").innerHTML = msgVi;
            document.getElementById("lockMsgEn").innerHTML = msgEn;
            pendingRedirect = redirectUrl || null;

            var iconEl = document.getElementById("lockIcon");
            var btnMain = document.getElementById("lockBtn");
            var btnCancel = document.getElementById("lockBtnCancel");

            if (isConfirmRetake) {
                iconEl.innerText = daDat ? "🏆" : "📝";
                iconEl.style.background = daDat ? "#dcfce7" : "#dbeafe";
                btnCancel.style.display = "block";
                btnMain.innerText = "🔄 Làm lại / Retake";
            } else {
                iconEl.innerText = "🔒";
                iconEl.style.background = "#fff3cd";
                btnCancel.style.display = "none";
                btnMain.innerText = pendingRedirect ? "Đăng nhập ngay / Sign in" : "Tiếp tục học / Continue Learning";
            }

            document.getElementById("lockModal").style.display = "flex";
        }

        function dongPopupKhoa() {
            document.getElementById("lockModal").style.display = "none";
            pendingRedirect = null;
        }

        function xacNhanPopup() {
            var url = pendingRedirect;
            document.getElementById("lockModal").style.display = "none";
            if (url) {
                window.location.href = url;
            }
        }

        function kiemTraMoKhoa(idCapDo) {
            fetch('/bai_test/KiemTraDieuKienTienDo?id_cap_do=' + idCapDo)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        if (data.hasHistory) {
                            // Đã từng làm -> hiện % cũ và hỏi có muốn làm lại không
                            moPopupKhoa(data.title, data.msgVi, data.msgEn, data.redirectUrl, true, data.daDat);
                        } else {
                            // Chưa làm lần nào -> vào thẳng trang làm bài
                            window.location.href = data.redirectUrl;
                        }
                    } else {
                        moPopupKhoa(data.title, data.msgVi, data.msgEn, data.redirectUrl, false, false);
                    }
                })
                .catch(() => {
                    moPopupKhoa(
                        "Lỗi kết nối / Connection Error",
                        "Không thể kết nối đến máy chủ. Vui lòng thử lại sau.",
                        "Unable to connect to the server. Please try again later.",
                        null, false, false
                    );
                });
        }
</script>