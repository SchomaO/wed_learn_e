@model wed_learn_e.Models.DanhSachCapDoViewModel
@{
    ViewBag.Title = "Khóa Đào Tạo";
    Layout = "~/Views/Shared/_Layoutcauhoi.cshtml";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #e9f5ff;
        overflow-x: hidden;
    }

    .kdt-container,
    .kdt-container *,
    .kdt-container *::before,
    .kdt-container *::after {
        box-sizing: border-box;
    }

    .kdt-container {
        width: 90%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 6px 0 60px;
    }

    .kdt-subtitle {
        text-align: center;
        color: #475569;
        font-size: 14px;
        margin: 0 0 20px;
    }

    /* Thanh trạng thái VIP gọn gàng */
    .kdt-vip-bar {
        width: 100%;
        background: #ffffff;
        border: 1px solid #cfe2ff;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 24px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        box-shadow: 0 3px 10px rgba(13, 110, 253, 0.06);
    }

        .kdt-vip-bar.is-vip {
            background: #fffbeb;
            border-color: #fcd34d;
        }

    .kdt-btn-vip {
        background: #f59e0b;
        color: #111827;
        font-weight: bold;
        padding: 7px 14px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
        transition: 0.2s;
    }

        .kdt-btn-vip:hover {
            background: #d97706;
            color: #fff;
        }

    /* Lưới thẻ gọn giống kích thước ban đầu */
    .kdt-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 22px;
    }

    .kdt-card {
        min-width: 0;
        border-radius: 12px;
        padding: 20px 18px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(13, 110, 253, 0.08);
        transition: 0.25s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .kdt-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
        }

    .kdt-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .kdt-icon {
        font-size: 32px;
        line-height: 1;
    }

    .kdt-badge {
        font-size: 11px;
        font-weight: bold;
        padding: 3px 9px;
        border-radius: 999px;
    }

    .badge-free {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-owned {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-forever {
        background: #e2e8f0;
        color: #475569;
    }

    .kdt-title {
        font-size: 19px;
        font-weight: bold;
        margin-bottom: 8px;
        color: #007bff;
    }

    .kdt-desc {
        font-size: 13.5px;
        color: #555;
        line-height: 1.45;
        margin-bottom: 16px;
        flex-grow: 1;
    }

    .kdt-price-box {
        border-top: 1px dashed #cbd5e1;
        padding-top: 12px;
        margin-bottom: 14px;
        min-height: 58px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .kdt-price-old {
        font-size: 13px;
        color: #94a3b8;
        text-decoration: line-through;
        margin-right: 5px;
    }

    .kdt-discount-tag {
        background: #fef3c7;
        color: #b45309;
        font-size: 11px;
        font-weight: bold;
        padding: 2px 7px;
        border-radius: 999px;
    }

    .kdt-price-now {
        font-size: 20px;
        font-weight: bold;
        color: #dc2626;
        margin-top: 2px;
    }

    .kdt-price-free {
        font-size: 17px;
        font-weight: bold;
        color: #16a34a;
    }

    .kdt-vip-note {
        font-size: 11.5px;
        color: #b45309;
        margin-top: 3px;
    }

    .kdt-btn {
        display: inline-block;
        width: 100%;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: 0.2s;
    }

    .kdt-btn-green {
        background: #28a745;
        color: #ffffff;
    }

        .kdt-btn-green:hover {
            background: #218838;
            color: #ffffff;
        }

    .kdt-btn-blue {
        background: #0d6efd;
        color: #ffffff;
    }

        .kdt-btn-blue:hover {
            background: #0b5ed7;
            color: #ffffff;
        }

    .kdt-alert {
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-size: 14px;
        font-weight: bold;
    }

    .kdt-alert-ok {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .kdt-alert-err {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* Con mèo góc dưới phải */
    .cat-mascot {
        position: fixed;
        bottom: 18px;
        right: 22px;
        z-index: 99;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

        .cat-mascot img {
            width: 46px;
            height: 46px;
        }

    .cat-text {
        background: #ffffff;
        color: #1e293b;
        padding: 5px 10px;
        border-radius: 10px;
        font-size: 12.5px;
        font-weight: bold;
        white-space: nowrap;
        margin-bottom: 5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .extra-title {
        text-align: center;
        margin-top: 25px;
        margin-bottom: 14px;
        font-size: 32px;
        font-weight: bold;
        color: #0b5ed7;
        position: relative;
    }

        .extra-title:after {
            content: "";
            width: 130px;
            height: 4px;
            background: #0d6efd;
            display: block;
            margin: 10px auto 0;
            border-radius: 4px;
        }
</style>

@Html.Partial("_NutQuayLai", new ViewDataDictionary {
    { "LinkQuayVe", Url.Action("Index", "Trang_chu") },
    { "TieuDe", "Khóa Đào Tạo Theo Cấp Độ" }
})

<div class="kdt-container">
    <p class="kdt-subtitle">Chọn cấp độ phù hợp để luyện tập đầy đủ các kỹ năng • Mua 1 lần sở hữu trọn đời</p>

    @if (TempData["Success"] != null)
    {
        <div class="kdt-alert kdt-alert-ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="kdt-alert kdt-alert-err">@TempData["Error"]</div>
    }

    @* Thanh trạng thái VIP *@
    <div class="kdt-vip-bar @(Model.DaNangCap ? "is-vip" : "")">
        @if (Model.DaNangCap)
        {
            <div>
                <strong style="color: #b45309;">👑 Tài khoản đã nâng cấp vĩnh viễn:</strong>
                <span>Hệ thống tự động giảm <strong>@Model.PhanTramGiamVip%</strong> học phí cho tất cả cấp độ bên dưới.</span>
            </div>
        }
        else
        {
            <div>
                <strong>💡 Ưu đãi học viên nâng cấp:</strong>
                <span>Nâng cấp 1 lần (@Model.GiaGoiNangCap.ToString("N0")đ) để được giảm ngay <strong>@Model.PhanTramGiamVip%</strong> học phí cho mọi cấp độ!</span>
            </div>
            if (Model.DaDangNhap)
            {
                <a href="@Url.Action("Index", "NangCap")" class="kdt-btn-vip">Nâng cấp tài khoản</a>
            }
            else
            {
                <a href="@Url.Action("Index", "Home")" class="kdt-btn-vip">Đăng nhập để nâng cấp</a>
            }
        }
    </div>

    @* Danh sách các Cấp độ *@
    <div class="kdt-grid">
        @{
            string[] colors = { "#ffffff", "#f0f8ff", "#e6f4ff", "#f5fbff", "#eef7ff", "#f2f9ff" };
            string[] icons = { "📘", "📗", "📙", "📕", "🎓", "🏆" };
        }

        @for (int i = 0; i < Model.DanhSachCapDo.Count; i++)
        {
            var item = Model.DanhSachCapDo[i];

            <div class="kdt-card" style="background: @(colors[i % colors.Length]);">
                <div>
                    <div class="kdt-card-top">
                        <span class="kdt-icon">@(icons[i % icons.Length])</span>
                        @if (item.IsMienPhiTheoGioiHan)
                        {
                            <span class="kdt-badge badge-free">Miễn phí</span>
                        }
                        else if (item.DaSoHuu)
                        {
                            <span class="kdt-badge badge-owned">✓ Đã sở hữu</span>
                        }
                        else
                        {
                            <span class="kdt-badge badge-forever">Trọn đời</span>
                        }
                    </div>

                    <div class="kdt-title">@item.TenCapDo</div>
                    <div class="kdt-desc">@item.MoTa</div>
                </div>

                <div>
                    @if (item.IsMienPhiTheoGioiHan)
                    {
                        <div class="kdt-price-box">
                            <div class="kdt-price-free">Miễn phí học thử</div>
                        </div>
                        <a href="@Url.Action("thong_tin_khoa_hoc", "Page", new { id = item.IdCapDo })" class="kdt-btn kdt-btn-green">
                            Vào học ngay
                        </a>
                    }
                    else if (item.DaSoHuu)
                    {
                        <div class="kdt-price-box">
                            <div style="font-size: 12.5px; color: #16a34a; font-weight: bold;">
                                Kích hoạt @(item.NgayMua.HasValue ? item.NgayMua.Value.ToString("dd/MM/yyyy") : "vĩnh viễn")
                            </div>
                        </div>
                        <a href="@Url.Action("thong_tin_khoa_hoc", "Page", new { id = item.IdCapDo })" class="kdt-btn kdt-btn-green">
                            Tiếp tục học
                        </a>
                    }
                    else
                    {
                        <div class="kdt-price-box">
                            @if (Model.DaNangCap && item.PhanTramGiam > 0)
                            {
                                <div>
                                    <span class="kdt-price-old">@item.GiaGoc.ToString("N0")đ</span>
                                    <span class="kdt-discount-tag">-@item.PhanTramGiam% VIP</span>
                                </div>
                                <div class="kdt-price-now">@item.GiaSauGiam.ToString("N0")đ</div>
                            }
                            else
                            {
                                decimal giaNeuVip = Math.Round(item.GiaGoc * (100 - Model.PhanTramGiamVip) / 100m, 0, MidpointRounding.AwayFromZero);
                                <div class="kdt-price-now">@item.GiaGoc.ToString("N0")đ</div>
                                <div class="kdt-vip-note">VIP chỉ còn <strong>@giaNeuVip.ToString("N0")đ</strong> (-@Model.PhanTramGiamVip%)</div>
                            }
                        </div>

                        if (!Model.DaDangNhap)
                        {
                            <a href="@Url.Action("Index", "Home")" class="kdt-btn kdt-btn-blue">Đăng nhập để mua</a>
                        }
                        else
                        {
                            using (Html.BeginForm("TaoDonCapDo", "MuaKhoaHoc", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idCapDo" value="@item.IdCapDo" />
                                <button type="submit" class="kdt-btn kdt-btn-blue">
                                    Mở khóa • @item.GiaSauGiam.ToString("N0")đ
                                </button>
                            }
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="cat-mascot">
    <div class="cat-text" id="catText">Let's learn English!</div>
    <img src="https://cdn-icons-png.flaticon.com/512/763/763704.png" alt="cat">
</div>

<script>
            const texts = ["Let's learn English!", "Practice makes perfect!", "Keep studying!", "You can do it!"];
            setInterval(() => {
                document.getElementById("catText").innerText = texts[Math.floor(Math.random() * texts.length)];
            }, 10000);
</script>